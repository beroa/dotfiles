# aliases
alias ch='clear ; tmux clear-history'
alias gco='git checkout'
alias gl='git log'
alias gs='git status'
alias git-delete-merged='git branch --merged main | grep -v "^\* main" | xargs -n 1 -r git branch -d'
alias g-b-d="git for-each-ref --sort='committerdate:iso8601' --format=' %(committerdate:iso8601)%09%(refname)' refs/heads"
alias mkdir='mkdir -p'
alias ll='ls -lahtr'

# keep one ssh-agent and load key once, so git over ssh does not reprompt every time
if command -v ssh-agent >/dev/null 2>&1 && command -v ssh-add >/dev/null 2>&1; then
  SSH_AGENT_ENV="$HOME/.ssh/agent_env"

  if [ -z "$SSH_AUTH_SOCK" ] && [ -r "$SSH_AGENT_ENV" ]; then
    source "$SSH_AGENT_ENV" >/dev/null 2>&1
  fi

  ssh-add -l >/dev/null 2>&1
  ssh_add_status=$?

  if [ "$ssh_add_status" -eq 2 ]; then
    eval "$(ssh-agent -s)" >/dev/null
    umask 077
    {
      echo "export SSH_AUTH_SOCK=$SSH_AUTH_SOCK"
      echo "export SSH_AGENT_PID=$SSH_AGENT_PID"
    } > "$SSH_AGENT_ENV"
    ssh-add -l >/dev/null 2>&1
    ssh_add_status=$?
  fi

  if [ "$ssh_add_status" -eq 1 ] && [ -r "$HOME/.ssh/id_ed25519" ] && [ -t 0 ]; then
    ssh-add "$HOME/.ssh/id_ed25519" </dev/tty
  fi

  unset ssh_add_status
fi

# start a unique tmux session for each window
if command -v tmux &> /dev/null; then
  # Keep local auto-start, but avoid nesting tmux when this shell is over SSH.
  if [ -z "$TMUX" ] && [ -z "${SSH_CONNECTION}${SSH_CLIENT}${SSH_TTY}" ]; then
    tmux new-session -s "session-$(date +%s)"
  fi
fi

# use vim
VISUAL=vim
EDITOR="$VISUAL"

# temple of navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias .......="cd ../../../../../.."
alias ........="cd ../../../../../../.."
alias .........="cd ../../../../../../../.."
alias ..........="cd ../../../../../../../../.."
alias ...........="cd ../../../../../../../../../.."
alias ............="cd ../../../../../../../../../../.."
alias .............="cd ../../../../../../../../../../../.."

# lots of history that persists
export HISTFILESIZE=1000000
export HISTSIZE=1000000
export HISTCONTROL=ignoredups:erasedups

# Git prompt: [branch] and [branch:x] when dirty.
git_prompt_info() {
  command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

  local branch dirty
  branch="$(command git rev-parse --abbrev-ref HEAD 2>/dev/null)" || return
  if [ "$branch" = "HEAD" ]; then
    branch="$(command git rev-parse --short HEAD 2>/dev/null)" || return
  fi

  if [ -n "$(command git status --porcelain --ignore-submodules=dirty 2>/dev/null)" ]; then
    dirty="%F{yellow}:x%F{#00ff00}"
  else
    dirty=""
  fi

  printf ' %s[%s%s%s%s' "%F{#5f00af}" "%F{#00ff00}" "$branch" "$dirty" "%F{#5f00af}]%f"
}

setopt PROMPT_SUBST
PROMPT="%F{#00ffff}%c%f\$(git_prompt_info) "
