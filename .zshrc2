# aliases
alias ch='clear ; tmux clear-history'
alias gco='git checkout'
alias gl='git log'
alias gs='git status'
alias git-delete-merged='git branch --merged main | grep -v "^\* main" | xargs -n 1 -r git branch -d'
alias g-b-d="git for-each-ref --sort='committerdate:iso8601' --format=' %(committerdate:iso8601)%09%(refname)' refs/heads"
alias mkdir='mkdir -p'
alias ll='ls -lahtr'

# keep one ssh-agent and load key once, so git over ssh does not reprompt every time
if command -v ssh-agent >/dev/null 2>&1 && command -v ssh-add >/dev/null 2>&1; then
  SSH_AGENT_ENV="$HOME/.ssh/agent_env"

  if [ -z "$SSH_AUTH_SOCK" ] && [ -r "$SSH_AGENT_ENV" ]; then
    source "$SSH_AGENT_ENV" >/dev/null 2>&1
  fi

  ssh-add -l >/dev/null 2>&1
  ssh_add_status=$?

  if [ "$ssh_add_status" -eq 2 ]; then
    eval "$(ssh-agent -s)" >/dev/null
    umask 077
    {
      echo "export SSH_AUTH_SOCK=$SSH_AUTH_SOCK"
      echo "export SSH_AGENT_PID=$SSH_AGENT_PID"
    } > "$SSH_AGENT_ENV"
    ssh-add -l >/dev/null 2>&1
    ssh_add_status=$?
  fi

  if [ "$ssh_add_status" -eq 1 ] && [ -r "$HOME/.ssh/id_ed25519" ] && [ -t 0 ]; then
    ssh-add "$HOME/.ssh/id_ed25519" </dev/tty
  fi

  unset ssh_add_status
fi

# start a unique tmux session for each window
if command -v tmux &> /dev/null; then
  # Keep local auto-start, but avoid nesting tmux when this shell is over SSH.
  if [ -z "$TMUX" ] && [ -z "${SSH_CONNECTION}${SSH_CLIENT}${SSH_TTY}" ]; then
    tmux new-session -s "session-$(date +%s)"
  fi
fi

# use vim
export VISUAL='vim'
export EDITOR="$VISUAL"

# temple of navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias .......="cd ../../../../../.."
alias ........="cd ../../../../../../.."
alias .........="cd ../../../../../../../.."
alias ..........="cd ../../../../../../../../.."
alias ...........="cd ../../../../../../../../../.."
alias ............="cd ../../../../../../../../../../.."
alias .............="cd ../../../../../../../../../../../.."

# lots of history that persists
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=1000000
SAVEHIST=1000000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY

# History search with arrow keys: typed prefix + up/down.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search vcs_info add-zsh-hook
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search
bindkey "^[OA" up-line-or-beginning-search
bindkey "^[OB" down-line-or-beginning-search

# Show completion choices in an interactive menu and allow matching from the middle or end of candidates.
zmodload zsh/complist
setopt AUTO_LIST
setopt AUTO_MENU
setopt COMPLETE_IN_WORD
zstyle ':completion:*' matcher-list \
  '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Git prompt via vcs_info keeps the branch indicator without running git status.
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' max-exports 1
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '%F{yellow}:+%F{#00ff00}'
zstyle ':vcs_info:git:*' unstagedstr '%F{yellow}:x%F{#00ff00}'
zstyle ':vcs_info:git:*' formats ' %F{#5f00af}[%F{#00ff00}%b%u%c%F{#5f00af}]%f'
zstyle ':vcs_info:git:*' actionformats ' %F{#5f00af}[%F{#00ff00}%b|%a%u%c%F{#5f00af}]%f'

precmd_update_vcs_info() {
  vcs_info
}

add-zsh-hook precmd precmd_update_vcs_info

setopt PROMPT_SUBST
PROMPT='%F{#00d7d7}%n@%m%f %F{#00ffff}%c%f${vcs_info_msg_0_} '
