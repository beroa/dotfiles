# aliases
alias ch='clear ; tmux clear-history'
alias gco='git checkout'
alias gl='git log'
alias gs='git status'
alias git-delete-merged='git branch --merged main | grep -v "^\* main" | xargs -n 1 -r git branch -d'
alias g-b-d="git for-each-ref --sort='committerdate:iso8601' --format=' %(committerdate:iso8601)%09%(refname)' refs/heads"
alias mkdir='mkdir -p'
alias ll='ls -lahtr'

# start a unique tmux session for each window
if command -v tmux &> /dev/null; then
  if [ -z "$TMUX" ]; then
    tmux new-session -s "session-$(date +%s)"
  fi
fi

# use vim
VISUAL=vim
EDITOR="$VISUAL"

# temple of navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias .......="cd ../../../../../.."
alias ........="cd ../../../../../../.."
alias .........="cd ../../../../../../../.."
alias ..........="cd ../../../../../../../../.."
alias ...........="cd ../../../../../../../../../.."
alias ............="cd ../../../../../../../../../../.."
alias .............="cd ../../../../../../../../../../../.."

# lots of history that persists
export HISTFILESIZE=1000000
export HISTSIZE=1000000
export HISTCONTROL=ignoredups:erasedups

# Keep theme choice in dotfiles; load it here for current ~/.zshrc order.
ZSH_THEME="robbyrussell"
if [ -n "$ZSH" ] && [ -r "$ZSH/themes/$ZSH_THEME.zsh-theme" ]; then
  source "$ZSH/themes/$ZSH_THEME.zsh-theme"
fi

# git prompt style: [branch] and [branch:x] when dirty
ZSH_THEME_GIT_PROMPT_PREFIX="%F{#5f00af}[%F{#00ff00}"
ZSH_THEME_GIT_PROMPT_DIRTY="%F{yellow}:x%F{#00ff00}"
ZSH_THEME_GIT_PROMPT_CLEAN=""
ZSH_THEME_GIT_PROMPT_SUFFIX="%F{#5f00af}]%f "

# robbyrussell prompt without the leading arrow
PROMPT="%F{#00ffff}%c%f"
PROMPT+=' $(git_prompt_info)'
