#!/usr/bin/env bash
# Paste macOS clipboard into the current tmux pane (invoked from tmux C-v bind).
set -euo pipefail

log_file="${TMUX_PASTE_LOG:-/tmp/tmux-paste.log}"

{
  echo "=== $(date '+%Y-%m-%dT%H:%M:%S%z') pid=$$ tmux=${TMUX:-unset} ==="
  if ! command -v pbpaste >/dev/null 2>&1; then
    echo "ERROR: pbpaste not found"
    exit 1
  fi
  if ! command -v tmux >/dev/null 2>&1; then
    echo "ERROR: tmux not found"
    exit 1
  fi
  clip_len="$(pbpaste | wc -c | tr -d ' ')"
  echo "clipboard_bytes=$clip_len pane=${TMUX_PANE:-unset}"
  paste_target=()
  if [[ -n "${TMUX_PANE:-}" ]]; then
    paste_target=(-t "$TMUX_PANE")
  fi
  if ! pbpaste | tmux load-buffer - \; paste-buffer -p "${paste_target[@]}"; then
    echo "ERROR: load-buffer or paste-buffer failed"
    exit 1
  fi
  echo "OK"
} >>"$log_file" 2>&1
